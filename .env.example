# ──────────────────────────────────────────────
# HAMMAH — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in actual values.
# Never commit .env.local to version control.
# Never use NEXT_PUBLIC_ prefix for secret keys.

# ── Supabase ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Cloudflare R2 ───────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# ── Application ─────────────────────────────
# Development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production should be configured in Vercel as:
# NEXT_PUBLIC_SITE_URL=https://www.hammah.store

# ── WhatsApp ────────────────────────────────
NEXT_PUBLIC_HAMMAH_WHATSAPP_NUMBER=

# ── Brevo transactional email ────────────────
# Server-only. Never expose these with NEXT_PUBLIC_.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Brevo template IDs (server-only)
BREVO_TEMPLATE_ID_ORDER_ADMIN=
BREVO_TEMPLATE_ID_ORDER_CUSTOMER=
BREVO_TEMPLATE_ID_HAMATEE_WELCOME=
BREVO_TEMPLATE_ID_BIRTHDAY=

# ── Scheduled jobs ─────────────────────────────
# Server-only. Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
